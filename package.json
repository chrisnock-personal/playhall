{
  "name": "playhall",
  "version": "0.1.0",
  "private": true,
  "description": "Game rooms with hosts, players and watchers: built-in games, shared local games, voice, video and chat",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts src/server/demo.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "demo": "tsx src/server/demo.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chess.js": "^1.4.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "pg": "^8.23.1",
    "selfsigned": "^5.5.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@lichess-org/chessground": "^10.5.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
