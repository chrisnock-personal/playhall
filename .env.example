# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32  (at least 32 characters; the server won't start without it)
JWT_SECRET=
# false = only existing accounts and guests; nobody can create a new account
ALLOW_SIGNUP=true
# Usernames that are admins (comma-separated): they get the platform settings page.
# Create the account first, then list it here and restart.
ADMIN_USERNAMES=
# Port on the host
PLAYHALL_PORT=8450
# HTTPS (on by default, with a self-signed certificate made on first start).
# off = plain HTTP, e.g. behind your own reverse proxy that does HTTPS.
TLS=on
# Extra names or addresses the self-signed certificate should cover, comma-separated
# (localhost and the container's own addresses are always in it), e.g. playhall.home,192.168.1.195
TLS_HOSTS=
# Voice and video (phase 2): start with `podman-compose --profile media up -d`.
# The URL is how Playhall reaches LiveKit inside compose; leave it as is.
LIVEKIT_URL=http://livekit:7880
# Any name, and a secret of at least 32 random characters (openssl rand -hex 32)
LIVEKIT_API_KEY=playhall
LIVEKIT_API_SECRET=
# The address browsers reach this machine on (LAN or public IP); UDP 7882 and TCP 7881 must be open to it
LIVEKIT_NODE_IP=
