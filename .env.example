# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32  (at least 32 characters; the server won't start without it)
JWT_SECRET=
# false = only existing accounts and guests; nobody can create a new account
ALLOW_SIGNUP=true
# Port on the host
PLAYHALL_PORT=8450
# HTTPS (on by default, with a self-signed certificate made on first start).
# off = plain HTTP, e.g. behind your own reverse proxy that does HTTPS.
TLS=on
# Extra names or addresses the self-signed certificate should cover, comma-separated
# (localhost and the container's own addresses are always in it), e.g. playhall.home,192.168.1.195
TLS_HOSTS=
